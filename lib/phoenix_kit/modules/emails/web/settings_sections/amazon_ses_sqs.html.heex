<div class="space-y-6">
  <%!-- Mailer Configuration status --%>
  <div class={[
    "alert",
    case @mailer_status.adapter do
      Swoosh.Adapters.AmazonSES -> if @aws_configured, do: "alert-success", else: "alert-warning"
      nil -> "alert-warning"
      _ -> "alert-info"
    end
  ]}>
    <.icon name="hero-information-circle" class="w-5 h-5 shrink-0" />
    <div class="w-full">
      <%= case @mailer_status.adapter do %>
        <% Swoosh.Adapters.AmazonSES -> %>
          <h3 class="font-bold flex items-center gap-2">
            {gettext("Mailer Adapter: Amazon SES")}
            <span class={["badge", if(@aws_configured, do: "badge-success", else: "badge-warning")]}>
              {if @aws_configured, do: gettext("Configured"), else: gettext("Not Configured")}
            </span>
          </h3>
          <p class="text-sm mt-1">
            {gettext("Configured via")}
            <code>config :{@mailer_status.config_app}, {inspect(@mailer_status.config_module)}</code>.
            <%= unless @aws_configured do %>
              {gettext(
                "Enter your AWS Access Key ID / Secret Access Key in AWS Configuration below, or set them via config :phoenix_kit, aws: [access_key_id: ..., secret_access_key: ...]."
              )}
            <% end %>
          </p>

        <% nil -> %>
          <h3 class="font-bold">{gettext("No Mailer Adapter Configured Yet")}</h3>
          <p class="text-sm mt-1">
            {gettext("Add this to your config/config.exs to start sending via Amazon SES:")}
          </p>
          <pre class="bg-base-300 rounded p-3 mt-2 text-xs overflow-x-auto"><code>{mailer_config_snippet(@mailer_status)}</code></pre>

        <% other -> %>
          <h3 class="font-bold">
            {gettext("Mailer Adapter: %{adapter}", adapter: inspect(other))}
          </h3>
          <p class="text-sm mt-1">
            {gettext(
              "Configured via your application's config — this admin panel manages Amazon SES only. To switch to Amazon SES, update your config to:"
            )}
          </p>
          <pre class="bg-base-300 rounded p-3 mt-2 text-xs overflow-x-auto"><code>{mailer_config_snippet(@mailer_status)}</code></pre>
      <% end %>
    </div>
  </div>

  <%!-- SES credentials source: pick an Integrations connection, or fall
       back to the legacy manual fields below --%>
  <div class="form-control w-full">
    <label class="label">
      <span class="label-text font-medium">{gettext("SES credentials source")}</span>
      <span class="label-text-alt text-sm text-base-content/60">
        {gettext("Choose which Integrations connection provides SES credentials")}
      </span>
    </label>
    <form
      id="aws-integration-picker-form"
      phx-submit="assign_aws_integration"
      phx-target={@myself}
      class="flex items-end gap-3"
    >
      <div class="grow">
        <.select
          name="uuid"
          value={@selected_aws_integration_uuid}
          prompt={gettext("— not assigned —")}
          options={Enum.map(@aws_ses_connections, &{&1.name, &1.uuid})}
          class="focus:select-primary"
        />
      </div>
      <.button type="submit" variant="primary" size="sm">{gettext("Assign")}</.button>
    </form>
    <label class="label">
      <span class="label-text-alt text-sm text-base-content/60">
        {gettext("Credentials, region and verification live in the connection itself —")}
        <.pk_link navigate="/admin/settings/integrations/website" class="link link-primary">
          {gettext("Settings → Integrations")}
        </.pk_link>
      </span>
    </label>
    <%= if @aws_ses_connections == [] do %>
      <label class="label">
        <span class="label-text-alt text-sm text-base-content/60">
          {gettext("No Amazon SES connections yet — create and verify one under Settings → Integrations, then assign it here.")}
        </span>
      </label>
    <% end %>
  </div>

  <%!-- Per-account event tracking: one row per SES account, each with its
       own queue/DLQ/topic/configuration set. SES only publishes events
       through a configuration set that lives in the SENDING account, so a
       second account needs its own pipeline, not a share of the first
       account's. --%>
  <div class="rounded-box border border-base-300 p-4 space-y-4">
    <div>
      <h3 class="font-semibold flex items-center gap-2">
        <.icon name="hero-queue-list" class="w-5 h-5" />
        {gettext("Per-account event tracking")}
      </h3>
      <p class="text-sm text-base-content/70 mt-1">
        {gettext(
          "Each Amazon SES account polls its own SQS queue with its own credentials. Add an account here, then run Setup Infrastructure to create its queue, topic and configuration set."
        )}
      </p>
    </div>

    <%!-- Active senders with no queue of their own. Polling has NOT stopped —
         SQSPollingJob falls back to the single global queue — but only one
         account's events are arriving, which is invisible from the tracking
         panel's "Running normally". --%>
    <div :if={@accounts_awaiting_configuration != []} class="alert alert-warning text-sm">
      <.icon name="hero-exclamation-triangle" class="w-5 h-5 shrink-0" />
      <div>
        <h4 class="font-semibold">
          {gettext("Some sending accounts have no event queue of their own")}
        </h4>
        <p class="mt-1">
          {gettext(
            "These accounts send mail but have no SQS queue configured here, so their delivery events are not being collected: %{names}. Add each one below and run Setup Infrastructure. Until then, only the single global queue is polled.",
            names: Enum.join(@accounts_awaiting_configuration, ", ")
          )}
        </p>
      </div>
    </div>

    <div :if={@tracking_accounts == []} class="text-sm text-base-content/60">
      {gettext("No accounts configured for event tracking yet.")}
    </div>

    <div :for={account <- @tracking_accounts} class="rounded-box bg-base-200 p-4 space-y-3">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <span class="font-medium">{account.name}</span>
          <span class={["badge badge-sm", if(account.active?, do: "badge-success", else: "badge-ghost")]}>
            {if account.active?,
              do: gettext("Active sender"),
              else: gettext("No enabled send profile")}
          </span>
        </div>
        <div class="flex items-center gap-2">
          <button
            type="button"
            phx-click="setup_account_infrastructure"
            phx-value-uuid={account.uuid}
            phx-target={@myself}
            class={[
              "btn btn-sm btn-accent",
              if(@setting_up_account == account.uuid, do: "loading", else: "")
            ]}
            disabled={not is_nil(@setting_up_account)}
          >
            <.icon name="hero-cog-6-tooth" class="w-4 h-4 mr-1" />
            {gettext("Setup Infrastructure")}
          </button>
          <button
            type="button"
            phx-click="unassign_tracking_account"
            phx-value-uuid={account.uuid}
            phx-target={@myself}
            class="btn btn-sm btn-ghost"
          >
            {gettext("Unassign")}
          </button>
        </div>
      </div>

      <form phx-submit="save_tracking_account" phx-target={@myself}>
        <input type="hidden" name="uuid" value={account.uuid} />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="form-control md:col-span-2">
            <label class="label">
              <span class="label-text font-medium">{gettext("SQS Queue URL")}</span>
            </label>
            <input
              name="tracking[queue_url]"
              type="url"
              placeholder="https://sqs.eu-north-1.amazonaws.com/123456789012/email-events"
              value={account.tracking[:queue_url]}
              class="input input-bordered focus:input-primary"
            />
          </div>

          <div class="form-control">
            <label class="label">
              <span class="label-text font-medium">{gettext("SQS Dead Letter Queue URL")}</span>
            </label>
            <input
              name="tracking[dlq_url]"
              type="url"
              value={account.tracking[:dlq_url]}
              class="input input-bordered focus:input-primary"
            />
          </div>

          <div class="form-control">
            <label class="label">
              <span class="label-text font-medium">{gettext("SQS Queue ARN")}</span>
            </label>
            <input
              name="tracking[queue_arn]"
              type="text"
              value={account.tracking[:queue_arn]}
              class="input input-bordered focus:input-primary"
            />
          </div>

          <div class="form-control">
            <label class="label">
              <span class="label-text font-medium">{gettext("SNS Topic ARN")}</span>
            </label>
            <input
              name="tracking[sns_topic_arn]"
              type="text"
              value={account.tracking[:sns_topic_arn]}
              class="input input-bordered focus:input-primary"
            />
          </div>

          <div class="form-control">
            <label class="label">
              <span class="label-text font-medium">{gettext("SES Configuration Set")}</span>
            </label>
            <input
              name="tracking[configuration_set]"
              type="text"
              value={account.tracking[:configuration_set]}
              class="input input-bordered focus:input-primary"
            />
            <label class="label">
              <span class="label-text-alt">
                {gettext("Must exist in THIS AWS account — SES publishes events only through it")}
              </span>
            </label>
          </div>

          <%!-- No region field: the queue URL names the region the queue is in,
          and the connection carries the region its credentials belong to.
          A third, hand-typed copy is how an account ends up signing for one
          region while its queue lives in another. --%>
          <div class="form-control">
            <label class="label">
              <span class="label-text font-medium">{gettext("Region")}</span>
            </label>
            <div class="input input-bordered flex items-center bg-base-100/60 font-mono text-sm">
              {account_region(account) || gettext("— from the connection —")}
            </div>
            <label class="label">
              <span class="label-text-alt">
                {gettext("Taken from the queue URL, or from the connection itself")}
              </span>
            </label>
          </div>
        </div>

        <div class="mt-3">
          <.button type="submit" variant="primary" size="sm">{gettext("Save")}</.button>
        </div>
      </form>
    </div>

    <form
      :if={@unassigned_connections != []}
      id="aws-tracking-assign-form"
      phx-submit="assign_tracking_account"
      phx-target={@myself}
      class="flex items-end gap-3"
    >
      <div class="grow">
        <.select
          name="uuid"
          value=""
          prompt={gettext("— select an Amazon SES connection —")}
          options={Enum.map(@unassigned_connections, &{&1.name, &1.uuid})}
          class="focus:select-primary"
        />
      </div>
      <.button type="submit" variant="primary" size="sm">{gettext("Add account")}</.button>
    </form>
  </div>

  <%!-- Event collection is switched on ONE place — the Amazon SES row in
  Delivery event tracking, which now owns both settings this gate needs.
  Showing the state here (read-only) keeps the answer where an operator looks
  for it without giving them a second switch for the same lamp. --%>
  <% collecting? = collecting_events?() %>
  <div class="text-sm flex items-center gap-2">
    <.icon
      name={if collecting?, do: "hero-check-circle", else: "hero-minus-circle"}
      class={"w-4 h-4 " <> if(collecting?, do: "text-success", else: "text-base-content/40")}
    />
    <span>
      {if collecting?,
        do: gettext("Delivery events from Amazon SES: collection is on"),
        else: gettext("Delivery events from Amazon SES: collection is off")}
    </span>
    <span class="text-base-content/60">
      {gettext("— switch it in Delivery event tracking above")}
    </span>
  </div>

  <%!-- Legacy manual credentials: no longer editable here. They keep working
       as a fallback until a connection is assigned, then become dead weight. --%>
  <div
    :if={@selected_aws_integration_uuid == "" and @aws_settings.access_key_id != ""}
    class="alert alert-warning text-sm"
  >
    <.icon name="hero-exclamation-triangle" class="w-5 h-5" />
    {gettext(
      "Sending currently uses legacy credentials stored in settings. Create a verified Amazon SES connection in Settings → Integrations and assign it above."
    )}
  </div>

    <%!-- The five global aws_* pipeline settings used to be edited here. They
    are the SAME fields the per-account rows above carry — and two of them
    (SNS topic ARN, queue ARN) are read by nothing at all. They survive only as
    the fallback for an install that has not moved to per-account tracking yet,
    so they are shown, not offered for editing: the account rows above are the
    one place to change them. --%>
    <div :if={legacy_settings_present?(@aws_settings)} class="mt-4">
      <.accordion id="legacy-aws-settings">
        <:title>{gettext("Inherited settings (legacy)")}</:title>
        <:content>
          <p class="text-sm text-base-content/70 mb-3">
            {gettext(
              "Used only by an account that has no tracking row of its own. Give that account its own queue above and these stop applying."
            )}
          </p>
          <dl class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
            <div>
              <dt class="text-base-content/60">{gettext("SES Configuration Set")}</dt>
              <dd class="font-mono break-all">{@aws_settings.ses_configuration_set}</dd>
            </div>
            <div>
              <dt class="text-base-content/60">{gettext("SQS Queue URL")}</dt>
              <dd class="font-mono break-all">{@aws_settings.sqs_queue_url}</dd>
            </div>
            <div>
              <dt class="text-base-content/60">{gettext("SQS DLQ URL")}</dt>
              <dd class="font-mono break-all">{@aws_settings.sqs_dlq_url}</dd>
            </div>
            <div>
              <dt class="text-base-content/60">{gettext("Region")}</dt>
              <dd class="font-mono break-all">{@aws_settings.region}</dd>
            </div>
          </dl>
        </:content>
      </.accordion>
    </div>

    <%!-- SQS Worker Tuning (collapse) — the master polling toggle and the
         polling interval now live in the "Delivery Event Tracking" panel
         (task #56 P2); this collapse keeps only the SQS-specific tuning
         knobs that panel has no generic column for. --%>
    <div class="collapse collapse-arrow bg-base-200 mt-4">
      <input type="checkbox" />
      <div class="collapse-title text-sm font-medium">
        <span class="flex items-center gap-2">
          <.icon name="hero-cog-6-tooth" class="w-5 h-5" /> {gettext("SQS Worker Tuning")}
        </span>
      </div>
      <div class="collapse-content text-sm space-y-4">
        <%!-- SQS Max Messages Per Poll --%>
        <div class="form-control">
          <label class="label">
            <span class="label-text font-medium">{gettext("Max Messages Per Poll")}</span>
          </label>
          <div class="input-group">
            <input
              name="max_messages"
              type="number"
              placeholder={gettext("Enter max messages")}
              class="input input-bordered w-full max-w-xs"
              value={@sqs_max_messages_per_poll}
              min="1"
              max="10"
              phx-blur="update_max_messages"
              phx-target={@myself}
            />
            <span class="bg-base-200 px-4 py-3 text-sm">{gettext("messages")}</span>
          </div>
          <label class="label">
            <span class="label-text-alt text-base-content/70">
              {gettext("Maximum number of messages to process in each polling cycle (1-10)")}
            </span>
          </label>
        </div>

        <%!-- SQS Visibility Timeout --%>
        <div class="form-control">
          <label class="label">
            <span class="label-text font-medium">{gettext("Visibility Timeout")}</span>
          </label>
          <div class="input-group">
            <input
              name="timeout"
              type="number"
              placeholder={gettext("Enter timeout")}
              class="input input-bordered w-full max-w-xs"
              value={@sqs_visibility_timeout}
              min="30"
              max="43200"
              phx-blur="update_visibility_timeout"
              phx-target={@myself}
            />
            <span class="bg-base-200 px-4 py-3 text-sm">{gettext("seconds")}</span>
          </div>
          <label class="label">
            <span class="label-text-alt text-base-content/70">
              {gettext(
                "How long messages remain invisible after being received (30-43200 seconds)"
              )}
            </span>
          </label>
        </div>

        <%!-- Performance Optimization Tips --%>
        <div class="alert alert-info">
          <.icon name="hero-light-bulb" class="w-4 h-4 shrink-0" />
          <div>
            <h4 class="font-semibold mb-2">{gettext("Performance Tips")}</h4>
            <ul class="text-sm space-y-1">
              <li>• {gettext("Use longer polling intervals (5-10 seconds) to reduce API calls")}</li>
              <li>• {gettext("Set visibility timeout to match processing time")}</li>
              <li>• {gettext("Monitor queue depth and adjust max messages accordingly")}</li>
              <li>• {gettext("Enable compression to reduce storage requirements")}</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

</div>
