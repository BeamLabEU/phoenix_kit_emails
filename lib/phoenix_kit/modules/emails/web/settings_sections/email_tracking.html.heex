<div class="space-y-6">
  <%!-- System status — every failure mode in this package is silent by design
       (the interceptor swallows its own errors so logging can never break a
       send), so the one thing the page must not do is let "enabled" stand in
       for "working". --%>
  <div class="card bg-base-200/40">
    <div class="card-body p-4 space-y-3">
      <h3 class="font-semibold text-base flex items-center gap-2">
        <.icon name="hero-signal" class="w-4 h-4" />
        {gettext("System status")}
      </h3>

      <div :if={@status.logging == :sender_invalid} class="alert alert-warning py-2">
        <.icon name="hero-exclamation-triangle" class="w-5 h-5 shrink-0" />
        <span class="text-sm">
          {gettext(
            "Nothing is being logged: the sender %{email} is not a full address, so every log write is rejected. Fix it in Settings → Email Sending.",
            email: @status.sender.email
          )}
        </span>
      </div>

      <%!-- `:no_oban_queue`, not `enabled? and not configured?`: with the whole
           system off the queue is off for that reason (the row below says so),
           and warning about a missing Oban queue then contradicts it. --%>
      <div :if={@status.queue.status == :no_oban_queue} class="alert alert-warning py-2">
        <.icon name="hero-exclamation-triangle" class="w-5 h-5 shrink-0" />
        <span class="text-sm">
          {gettext(
            "The queue is on, but this application has no :emails Oban queue configured, so nothing can drain it — messages are being sent immediately instead. Add `emails: 10` to the host's Oban queues to use the queue."
          )}
        </span>
      </div>

      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 text-sm">
        <div class="flex justify-between gap-2">
          <dt class="text-base-content/60">{gettext("Logging")}</dt>
          <dd class="font-medium">
            <span :if={@status.logging == :active} class="badge badge-success badge-sm">
              {gettext("Recording")}
            </span>
            <span :if={@status.logging == :system_disabled} class="badge badge-ghost badge-sm">
              {gettext("System off — nothing is written")}
            </span>
            <span :if={@status.logging == :sender_invalid} class="badge badge-warning badge-sm">
              {gettext("Blocked by sender address")}
            </span>
          </dd>
        </div>

        <div class="flex justify-between gap-2">
          <dt class="text-base-content/60">{gettext("What is logged")}</dt>
          <dd class="font-medium">
            {if @status.sampling_rate >= 100,
              do: gettext("Every message"),
              else:
                gettext("System mail, plus %{rate}% of the rest",
                  rate: @status.sampling_rate
                )}
          </dd>
        </div>

        <div class="flex justify-between gap-2">
          <dt class="text-base-content/60">{gettext("Sending through")}</dt>
          <dd class="font-medium text-right">
            {if @status.transport.kind == :integration,
              do: @status.transport.name || gettext("Default integration"),
              else: gettext("App config: %{adapter}", adapter: @status.transport.adapter)}
          </dd>
        </div>

        <div class="flex justify-between gap-2">
          <dt class="text-base-content/60">{gettext("Sender")}</dt>
          <dd class="font-medium">{@status.sender.email}</dd>
        </div>

        <div class="flex justify-between gap-2">
          <dt class="text-base-content/60">{gettext("Queue")}</dt>
          <dd class="font-medium">
            {case @status.queue.status do
              :system_disabled ->
                gettext("Off (system disabled)")

              :queue_disabled ->
                gettext("Off — sending inline")

              :no_oban_queue ->
                gettext("Off — no :emails Oban queue, sending inline")

              :ok ->
                gettext("On — %{pending} waiting, %{executing} sending, %{retryable} retrying",
                  pending: @status.queue.pending,
                  executing: @status.queue.executing,
                  retryable: @status.queue.retryable
                )
            end}
          </dd>
        </div>

        <div class="flex justify-between gap-2">
          <dt class="text-base-content/60">{gettext("Authentication mail")}</dt>
          <dd class="font-medium">
            {if @status.queue.auth_mail?,
              do: gettext("Queued like everything else"),
              else: gettext("Sent immediately, never queued")}
          </dd>
        </div>

        <div class="flex justify-between gap-2 sm:col-span-2">
          <dt class="text-base-content/60">{gettext("Today")}</dt>
          <dd class="font-medium">
            {gettext(
              "%{logged} logged · %{sent} sent · %{failed} failed · %{queued} queued",
              logged: @status.today.logged,
              sent: @status.today.sent,
              failed: @status.today.failed,
              queued: @status.today.queued
            )}
          </dd>
        </div>
      </dl>
    </div>
  </div>

  <div class="divider"></div>

  <%!-- Send queue — the card above only reports these two; without a switch the
       operator's only way to turn a default-on queue off is the settings table. --%>
  <div class="form-control">
    <.checkbox
      name="email_tracking[queue_enabled]"
      checked={@status.queue.enabled?}
      phx-click="toggle_email_queue"
      phx-target={@myself}
      label={gettext("Queue Outgoing Emails")}
    >
      <:description>
        {gettext(
          "Hand outgoing mail to the :emails Oban queue instead of sending it on the request. Requires `emails: N` in the host application's Oban queues; without it mail is sent immediately."
        )}
      </:description>
    </.checkbox>
  </div>

  <div :if={@status.queue.enabled?} class="form-control mt-2">
    <.checkbox
      name="email_tracking[queue_auth_mail]"
      checked={@status.queue.auth_mail?}
      phx-click="toggle_email_queue_auth_mail"
      phx-target={@myself}
      label={gettext("Queue Authentication Emails Too")}
    >
      <:description>
        {gettext(
          "Off by default: password resets and confirmations are sent immediately, so a stuck queue cannot turn into \"I never got the email\"."
        )}
      </:description>
    </.checkbox>
  </div>

  <div class="divider"></div>

  <%!-- Save Email Bodies --%>
  <div class="form-control">
    <.checkbox
      name="email_tracking[save_body]"
      checked={@email_save_body}
      phx-click="toggle_email_save_body"
      phx-target={@myself}
      label={gettext("Save Email Bodies")}
    >
      <:description>
        {gettext("Store the full content of sent emails for debugging and analysis")}
      </:description>
    </.checkbox>
  </div>

  <div class="divider"></div>

  <%!-- Save Email Headers --%>
  <div class="form-control">
    <.checkbox
      name="email_tracking[save_headers]"
      checked={@email_save_headers}
      phx-click="toggle_email_save_headers"
      phx-target={@myself}
      label={gettext("Save Email Headers")}
    >
      <:description>
        {gettext("Store email headers for debugging and analysis (increases storage usage)")}
      </:description>
    </.checkbox>
  </div>

  <div class="divider"></div>

  <%!-- Sampling Rate --%>
  <div class="form-control">
    <label class="label">
      <span class="label-text text-lg font-semibold">{gettext("Emails Sampling Rate")}</span>
    </label>
    <div class="input-group">
      <input
        name="sampling_rate"
        type="number"
        placeholder={gettext("Enter sampling rate")}
        class="input input-bordered w-full max-w-xs"
        value={@email_sampling_rate}
        min="0"
        max="100"
        phx-blur="update_email_sampling_rate"
        phx-target={@myself}
      />
      <span class="bg-base-200 px-4 py-3 text-sm">%</span>
    </div>
    <label class="label">
      <span class="label-text-alt text-base-content/70">
        {gettext("Percentage of emails to fully track for analytics (0-100%)")}
      </span>
    </label>
  </div>

  <.section_header icon="hero-archive-box" title={gettext("Data Retention")} />

  <%!-- Retention Period --%>
  <div class="form-control">
    <label class="label">
      <span class="label-text text-lg font-semibold">{gettext("Email Retention Period")}</span>
    </label>
    <div class="flex gap-2 items-start">
      <div class="input-group flex-1">
        <input
          name="retention_days"
          type="number"
          placeholder={gettext("Enter retention days")}
          class="input input-bordered w-full max-w-xs"
          value={@email_retention_days}
          min="1"
          max="365"
          phx-blur="update_email_retention"
          phx-target={@myself}
        />
        <span class="bg-base-200 px-4 py-3 text-sm">{gettext("days")}</span>
      </div>
      <button
        type="button"
        phx-click="run_cleanup_now"
        phx-target={@myself}
        class={["btn btn-warning btn-sm", if(@running_cleanup, do: "loading", else: "")]}
        disabled={@running_cleanup}
      >
        <%= if @running_cleanup do %>
          {gettext("Running...")}
        <% else %>
          <.icon name="hero-trash" class="w-4 h-4 mr-1" /> {gettext("Run Cleanup Now")}
        <% end %>
      </button>
    </div>
    <label class="label">
      <span class="label-text-alt text-base-content/70">
        {gettext("How long to keep emails data before automatic cleanup (1-365 days)")}
      </span>
    </label>
  </div>

  <div class="divider"></div>

  <%= if @email_save_body do %>
    <%!-- Compress Body After Days --%>
    <div class="form-control">
      <label class="label">
        <span class="label-text text-lg font-semibold">
          {gettext("Compress Email Bodies After")}
        </span>
        <span class="label-text-alt text-base-content/70">
          {gettext("Auto-saves when you click outside the input field")}
        </span>
      </label>
      <div class="flex gap-2 items-start">
        <div class="input-group flex-1">
          <input
            name="compress_days"
            type="number"
            placeholder={gettext("Enter compression days")}
            class={[
              "input input-bordered w-full max-w-xs",
              "transition-colors duration-200",
              "focus:input-primary",
              if(@updating_compress_days, do: "input-warning loading", else: "")
            ]}
            value={@email_compress_body}
            min="7"
            max="365"
            phx-blur="update_compress_days"
            phx-target={@myself}
          />
          <span class="bg-base-200 px-4 py-3 text-sm">{gettext("days")}</span>
        </div>
        <button
          type="button"
          phx-click="run_compression_now"
          phx-target={@myself}
          class={["btn btn-info btn-sm", if(@running_compression, do: "loading", else: "")]}
          disabled={@running_compression}
        >
          <%= if @running_compression do %>
            {gettext("Compressing...")}
          <% else %>
            <.icon name="hero-archive-box-arrow-down" class="w-4 h-4 mr-1" />
            {gettext("Compress Now")}
          <% end %>
        </button>
      </div>
      <label class="label">
        <span class="label-text-alt text-base-content/70">
          <span class="flex items-center gap-1">
            <.icon name="hero-information-circle" class="w-3 h-3" />
            {gettext(
              "Compress old email bodies to save storage space (7-365 days). Changes are saved automatically."
            )}
          </span>
        </span>
      </label>
    </div>

    <div class="divider"></div>
  <% end %>

  <%!-- S3 Archival — NOT IMPLEMENTED YET. The real uploader (Archiver) is not
  wired to anything: the button below calls a placeholder that loads the logs
  and returns them without touching S3, the bucket name has no setter, the log
  table has no archived_at/s3_key columns, and there is no scheduled worker.
  The toggle stays visible so the plan is not forgotten, but it is disabled and
  labelled rather than quietly reporting success. --%>
  <div class="form-control">
    <div class="flex items-center gap-2">
      <.checkbox
        name="email_tracking[archive_to_s3]"
        checked={false}
        disabled
        label={gettext("Enable S3 Archival")}
      >
        <:description>
          {gettext("Move old email data to AWS S3 for long-term cold storage")}
        </:description>
      </.checkbox>
      <span class="badge badge-warning badge-sm">{gettext("In development")}</span>
    </div>
    <p class="text-sm text-base-content/70 mt-1">
      {gettext(
        "Not available yet: nothing is uploaded to S3. Retention cleanup below already removes old records."
      )}
    </p>
  </div>

  <div class="alert alert-warning mt-2">
    <.icon name="hero-exclamation-triangle" class="w-5 h-5" />
    <div>
      <h3 class="font-bold">{gettext("Data Privacy Notice")}</h3>
      <p class="text-sm mt-1">
        {gettext(
          "Email data will be automatically deleted after the retention period expires. This helps maintain privacy compliance and reduces storage requirements."
        )}
      </p>
    </div>
  </div>
</div>
